{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "f=\"$CLAUDE_PLUGIN_ROOT/hooks/scripts/session-start.sh\"; [ -f \"$f\" ] && exec sh \"$f\"; cat >/dev/null 2>&1; exit 0", "timeout": 5 } ] }
    ],
    "PreToolUse": [
      { "matcher": ".*", "hooks": [ { "type": "command", "command": "f=\"$CLAUDE_PLUGIN_ROOT/hooks/scripts/ariadne-hook.sh\"; [ -f \"$f\" ] && exec sh \"$f\"; cat >/dev/null 2>&1; exit 0", "timeout": 2 } ] }
    ],
    "PostToolUse": [
      { "matcher": ".*", "hooks": [ { "type": "command", "command": "f=\"$CLAUDE_PLUGIN_ROOT/hooks/scripts/ariadne-hook.sh\"; [ -f \"$f\" ] && exec sh \"$f\"; cat >/dev/null 2>&1; exit 0", "timeout": 2 } ] }
    ]
  }
}
